# check-or-mate — local environment
# No secrets are required for local development.

# Optional: path to a local Stockfish binary used by the analysis engine.
# If unset, the engine falls back to the binary found on PATH.
STOCKFISH_PATH=

# ── Azure OpenAI integration (optional) ─────────────────────────────────────
# Used to generate natural-language game summaries from Stockfish analysis.
# Required only for the summary feature; scoring runs without it.

AZURE_OPENAI_ENDPOINT=https://checkormate.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
OPENAI_API_KEY=[DO_NOT_TRY_THIS_AT_HOME]
